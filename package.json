{
  "name": "scmc-charity-sale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:placeholders": "node scripts/generate-placeholders.mjs",
    "deploy": "npm run build && wrangler pages deploy --project-name=scmc-charity-sale",
    "deploy:help": "wrangler pages deploy --help",
    "deploy:github": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.124.0"
  }
}